# =============================================================================
# BANGLADESH COURSE MARKETPLACE — EXAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` (in apps/web) and fill in real credentials.
# NEVER commit real secrets or service-role keys to version control.
# =============================================================================

# --- Environment Mode ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"

# --- Supabase Configuration (Shared Backend & Auth) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key-here"
# SERVER-ONLY: Never expose SUPABASE_SERVICE_ROLE_KEY to client or Android code
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key-here"

# --- Payment Gateway Configuration (Bangladesh Merchant Integration) ---
# Allowed values in dev: "mock_sandbox" | "sslcommerz" | "bkash"
PAYMENT_PROVIDER="mock_sandbox"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"
PAYMENT_WEBHOOK_SECRET="replace-with-high-entropy-webhook-hmac-secret"

# --- Video Streaming & Signed Playback Configuration ---
# Allowed values: "supabase_signed" | "cloudflare_stream" | "mux"
VIDEO_DELIVERY_PROVIDER="supabase_signed"
VIDEO_SIGNING_SECRET="replace-with-private-signing-key"
VIDEO_URL_TTL_SECONDS="3600"
